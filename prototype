<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SKYLIGHT — Chapter 1: The First Resonance</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap');

    :root {
      --bg-dark: #0b0f19;
      --accent-gold: #fbbf24;
      --accent-cyan: #38bdf8;
      --accent-violet: #a855f7;
    }

    * {
      box-sizing: border-box;
      user-select: none;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      color: #f8fafc;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    #game-wrapper {
      position: relative;
      width: 95vw;
      max-width: 950px;
      height: 85vh;
      max-height: 650px;
      background: #0d1322;
      border: 1px solid rgba(56, 189, 248, 0.25);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8),
                  0 0 40px rgba(56, 189, 248, 0.12);
      display: flex;
      flex-direction: column;
    }

    /* Top Navigation Header */
    .game-header {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      padding: 16px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 20;
      background: linear-gradient(180deg, rgba(11, 15, 25, 0.9) 0%, rgba(11, 15, 25, 0) 100%);
    }

    .brand {
      font-size: 1.1rem;
      font-weight: 800;
      letter-spacing: 3px;
      color: #f8fafc;
      text-shadow: 0 0 12px rgba(56, 189, 248, 0.6);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-icon {
      width: 14px;
      height: 14px;
      border: 2.5px solid var(--accent-cyan);
      transform: rotate(45deg);
      box-shadow: 0 0 8px var(--accent-cyan);
    }

    .status-badge {
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      padding: 6px 14px;
      border-radius: 20px;
      background: rgba(56, 189, 248, 0.15);
      border: 1px solid rgba(56, 189, 248, 0.35);
      color: var(--accent-cyan);
      text-transform: uppercase;
      transition: all 0.4s ease;
    }

    .status-badge.chapter-1 {
      background: rgba(168, 85, 247, 0.2);
      border-color: rgba(168, 85, 247, 0.5);
      color: #e9d5ff;
      box-shadow: 0 0 15px rgba(168, 85, 247, 0.3);
    }

    /* Canvas Viewport */
    #viewport {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      cursor: pointer;
    }

    /* Narrative Box */
    .narrative-overlay {
      position: absolute;
      top: 75px;
      left: 50%;
      transform: translateX(-50%);
      width: 88%;
      max-width: 620px;
      text-align: center;
      z-index: 15;
      background: rgba(13, 19, 34, 0.7);
      backdrop-filter: blur(10px);
      padding: 12px 20px;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      pointer-events: none;
    }

    .narrative-text {
      font-size: 0.95rem;
      font-weight: 400;
      line-height: 1.5;
      color: #e2e8f0;
      min-height: 2.8em;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Floating Dialogue Bubble above Character */
    .dialogue-bubble {
      position: absolute;
      z-index: 18;
      background: rgba(15, 23, 42, 0.92);
      border: 1.5px solid rgba(56, 189, 248, 0.5);
      border-radius: 16px;
      padding: 10px 16px;
      max-width: 260px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5), 0 0 15px rgba(56, 189, 248, 0.2);
      pointer-events: none;
      transform: translate(-50%, -100%);
      transition: opacity 0.3s ease, transform 0.3s ease;
      opacity: 0;
    }

    .dialogue-bubble.visible {
      opacity: 1;
      transform: translate(-50%, -110%);
    }

    .dialogue-bubble::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      border-width: 8px 8px 0 8px;
      border-style: solid;
      border-color: rgba(15, 23, 42, 0.92) transparent transparent transparent;
    }

    .dialogue-speaker {
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 1px;
      color: var(--accent-gold);
      margin-bottom: 2px;
      text-transform: uppercase;
    }

    .dialogue-content {
      font-size: 0.82rem;
      color: #f1f5f9;
      line-height: 1.35;
    }

    /* Controls Panel */
    .controls-panel {
      position: absolute;
      bottom: 20px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 15;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      width: 90%;
      max-width: 440px;
      background: rgba(15, 23, 42, 0.82);
      backdrop-filter: blur(14px);
      padding: 14px 22px;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 15px 30px rgba(0,0,0,0.5);
    }

    .control-label {
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #94a3b8;
    }

    .slider-container {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    input[type=range] {
      -webkit-appearance: none;
      width: 100%;
      background: rgba(255, 255, 255, 0.12);
      height: 8px;
      border-radius: 4px;
      outline: none;
    }

    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--accent-cyan);
      box-shadow: 0 0 12px var(--accent-cyan);
      cursor: pointer;
      transition: transform 0.15s ease, background-color 0.3s;
    }

    input[type=range]::-webkit-slider-thumb:hover {
      transform: scale(1.2);
    }

    .btn {
      background: linear-gradient(135deg, #38bdf8, #0284c7);
      color: #0f172a;
      border: none;
      padding: 10px 28px;
      border-radius: 30px;
      font-weight: 800;
      font-size: 0.85rem;
      letter-spacing: 1px;
      cursor: pointer;
      box-shadow: 0 4px 15px rgba(56, 189, 248, 0.4);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(56, 189, 248, 0.6);
    }

    /* Resonance Meter Bar */
    .resonance-wrapper {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-top: 2px;
    }

    .resonance-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      font-weight: 700;
      color: #cbd5e1;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .resonance-bar-bg {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      overflow: hidden;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .resonance-bar-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #38bdf8, #a855f7, #fbbf24);
      border-radius: 4px;
      transition: width 0.15s linear;
      box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
    }

    .top-left-menu {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 25;
      display: flex;
      gap: 6px;
    }

    .mode-switch {
      position: absolute;
      top: 20px;
      right: 20px;
      z-index: 25;
      display: flex;
      gap: 8px;
    }

    .menu-btn {
      background: rgba(15, 23, 42, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #94a3b8;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .menu-btn.active, .mode-btn.active {
      background: var(--accent-cyan);
      color: #0f172a;
      border-color: var(--accent-cyan);
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.5);
    }

    .mode-btn {
      background: rgba(15, 23, 42, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #94a3b8;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.25s ease;
      font-size: 0.9rem;
    }

    .vignette {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 5;
      background: radial-gradient(circle, transparent 40%, rgba(11, 15, 25, 0.85) 100%);
    }

    @media (max-width: 600px) {
      .narrative-overlay { width: 92%; top: 65px; padding: 10px; }
      .narrative-text { font-size: 0.85rem; }
      .controls-panel { width: 94%; padding: 12px 16px; bottom: 12px; }
    }
  </style>
</head>
<body>

  <!-- Game Container -->
  <div id="game-wrapper">
    <!-- Header -->
    <div class="game-header">
      <div class="brand">
        <div class="brand-icon"></div>
        SKYLIGHT
      </div>
      <div class="status-badge" id="stage-badge">CHAPTER 0: INTRO</div>
    </div>

    <!-- Weather Selector -->
    <div class="top-left-menu">
      <button class="menu-btn active" id="weather-clear">☀️ Clear</button>
      <button class="menu-btn" id="weather-rain">🌧️ Rain</button>
      <button class="menu-btn" id="weather-snow">❄️ Snow</button>
    </div>

    <!-- Mode Toggle Day/Night -->
    <div class="mode-switch">
      <button class="mode-btn active" id="btn-day" title="Solis (Day)">☀️</button>
      <button class="mode-btn" id="btn-night" title="Luna (Night)">🌙</button>
    </div>

    <!-- Viewport Canvas Area -->
    <div id="viewport">
      <canvas id="gameCanvas"></canvas>
      <div class="vignette"></div>

      <!-- Narrative Overlay -->
      <div class="narrative-overlay">
        <p class="narrative-text" id="narrative"></p>
      </div>

      <!-- Floating Dynamic Character Dialogue -->
      <div class="dialogue-bubble" id="dialogue-bubble">
        <div class="dialogue-speaker" id="dialogue-speaker">Solis</div>
        <div class="dialogue-content" id="dialogue-content">...</div>
      </div>

      <!-- Controls Panel -->
      <div class="controls-panel" id="controls">
        <div class="control-label" id="control-label">Press start to awaken your skylight</div>
        
        <button class="btn" id="action-btn">
          <span>AWAKEN SKYLIGHT</span>
        </button>

        <div class="slider-container" id="slider-box" style="display: none;">
          <span style="font-size: 0.85rem;" id="slider-icon-min">🔒</span>
          <input type="range" id="skylight-slider" min="0" max="100" value="0">
          <span style="font-size: 0.85rem;" id="slider-icon-max">☀️</span>
        </div>

        <!-- Resonance Progress Bar -->
        <div class="resonance-wrapper" id="resonance-box" style="display: none;">
          <div class="resonance-header">
            <span id="quest-label">Core Alignment Resonance</span>
            <span id="resonance-val">0%</span>
          </div>
          <div class="resonance-bar-bg">
            <div class="resonance-bar-fill" id="resonance-fill"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    /* Audio Engine utilizing Web Audio API for cozy synthesized sounds */
    const AudioEngine = {
      ctx: null,
      init() {
        if (!this.ctx) {
          this.ctx = new (window.AudioContext || window.webkitAudioContext)();
        }
      },
      playChime() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(523.25, now);
        osc.frequency.exponentialRampToValueAtTime(1046.50, now + 1.2);
        gain.gain.setValueAtTime(0.25, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 1.2);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 1.2);
      },
      playClick() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'triangle';
        osc.frequency.setValueAtTime(600, now);
        osc.frequency.exponentialRampToValueAtTime(300, now + 0.08);
        gain.gain.setValueAtTime(0.15, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.08);
      },
      playSlideSound() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(180, now);
        osc.frequency.linearRampToValueAtTime(120, now + 0.1);
        gain.gain.setValueAtTime(0.08, now);
        gain.gain.linearRampToValueAtTime(0.001, now + 0.1);
        osc.connect(gain);
        gain.connect(this.ctx.destination);
        osc.start(now);
        osc.stop(now + 0.1);
      },
      playChapterFanfare() {
        if (!this.ctx) return;
        const notes = [440, 554.37, 659.25, 880];
        notes.forEach((freq, idx) => {
          const now = this.ctx.currentTime + (idx * 0.15);
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, now);
          gain.gain.setValueAtTime(0.2, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);
          osc.connect(gain);
          gain.connect(this.ctx.destination);
          osc.start(now);
          osc.stop(now + 0.8);
        });
      }
    };

    // Canvas Setup
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    let width, height;

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      canvas.width = rect.width;
      canvas.height = rect.height;
      width = canvas.width;
      height = canvas.height;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // Game Core State
    const state = {
      stage: 0, // 0: Intro, 1: Opening Panel, 2: Prism Alignment, 3: Chapter 1 Unlocked
      aperture: 0,
      prismAngle: 0,
      resonance: 0, // 0 to 100
      mode: 'day', // 'day' (Solis) or 'night' (Luna)
      weather: 'clear', // 'clear', 'rain', 'snow'
      solisPos: { x: 0, y: 0, targetX: 0, alpha: 1 },
      lunaPos: { x: 0, y: 0, targetX: 0, alpha: 0 },
      dustParticles: [],
      weatherParticles: [],
      stars: [],
      targetCore: { x: 0, y: 0 },
      animTime: 0,
      dialogueIndex: { solis: 0, luna: 0 },
      dialogues: {
        solis: [
          "Solis: 'Hey there! I'm Solis. Tap me anytime!'",
          "Solis: 'Slide open the ceiling skylight to gather sunlight!'",
          "Solis: 'Rotate the prism angle so the beam hits the Energy Core!'",
          "Solis: 'Awesome! 100% Resonance awakens the Prism Shrine!'"
        ],
        luna: [
          "Luna: 'Greetings... I am Luna. The night is full of wonder.'",
          "Luna: 'Starlight holds ancient memory inside this room.'",
          "Luna: 'Align the skylight beam gently toward the resting core.'",
          "Luna: 'Listen... Chapter 1 has begun. The sanctuary is alive!'"
        ]
      }
    };

    // Initialize environment particles
    for (let i = 0; i < 70; i++) {
      state.stars.push({
        x: Math.random(),
        y: Math.random(),
        size: Math.random() * 2 + 0.5,
        alpha: Math.random(),
        speed: Math.random() * 0.02 + 0.005
      });
    }
    for (let i = 0; i < 50; i++) {
      state.dustParticles.push({
        x: Math.random(),
        y: Math.random(),
        size: Math.random() * 2 + 1,
        vx: (Math.random() - 0.5) * 0.0005,
        vy: (Math.random() - 0.5) * 0.0005 + 0.0002,
        alpha: Math.random() * 0.6 + 0.2
      });
    }
    for (let i = 0; i < 60; i++) {
      state.weatherParticles.push({
        x: Math.random(),
        y: Math.random(),
        speed: Math.random() * 3 + 2,
        size: Math.random() * 2 + 1
      });
    }

    /* DOM Element References */
    const narrativeEl = document.getElementById('narrative');
    const actionBtn = document.getElementById('action-btn');
    const sliderBox = document.getElementById('slider-box');
    const skylightSlider = document.getElementById('skylight-slider');
    const controlLabel = document.getElementById('control-label');
    const stageBadge = document.getElementById('stage-badge');
    const btnDay = document.getElementById('btn-day');
    const btnNight = document.getElementById('btn-night');
    const weatherClearBtn = document.getElementById('weather-clear');
    const weatherRainBtn = document.getElementById('weather-rain');
    const weatherSnowBtn = document.getElementById('weather-snow');
    const resonanceBox = document.getElementById('resonance-box');
    const resonanceFill = document.getElementById('resonance-fill');
    const resonanceVal = document.getElementById('resonance-val');
    const dialogueBubble = document.getElementById('dialogue-bubble');
    const dialogueSpeaker = document.getElementById('dialogue-speaker');
    const dialogueContent = document.getElementById('dialogue-content');
    const sliderIconMin = document.getElementById('slider-icon-min');
    const sliderIconMax = document.getElementById('slider-icon-max');

    const narrativeSteps = [
      "Every room is trapped in darkness. Yours holds a hidden gateway.",
      "Slide open the Skylight ceiling panel to invite the first beam of light.",
      "Rotate the prism lens angle to channel light directly into the Energy Core.",
      "✨ Chapter 1 Unlocked: The First Resonance! The Prism Shrine is awakened!"
    ];

    /* Typewriter Narrative Helper */
    function typeWriter(text, element, callback) {
      element.textContent = '';
      let i = 0;
      const timer = setInterval(() => {
        if (i < text.length) {
          element.textContent += text.charAt(i);
          i++;
        } else {
          clearInterval(timer);
          if (callback) callback();
        }
      }, 22);
    }

    typeWriter(narrativeSteps[0], narrativeEl);

    /* Show floating dialogue bubble above active character */
    function showDialogue(speaker, text) {
      dialogueSpeaker.textContent = speaker;
      dialogueContent.textContent = text;
      dialogueBubble.classList.add('visible');
    }

    /* Handle Action Button Progression */
    actionBtn.addEventListener('click', () => {
      AudioEngine.init();
      AudioEngine.playChime();
      if (state.stage === 0) {
        state.stage = 1;
        stageBadge.textContent = "CHAPTER 0: UNLOCK CEILING";
        typeWriter(narrativeSteps[1], narrativeEl);
        actionBtn.style.display = 'none';
        sliderBox.style.display = 'flex';
        resonanceBox.style.display = 'flex';
        controlLabel.textContent = "DRAG TO OPEN SKYLIGHT PANEL";
        showDialogue("Solis", state.dialogues.solis[1]);
      }
    });

    /* Slider Interactions for Skylight and Prism Angle */
    skylightSlider.addEventListener('input', (e) => {
      AudioEngine.playSlideSound();
      const val = parseFloat(e.target.value);
      if (state.stage === 1) {
        state.aperture = val;
        if (val >= 95) {
          state.stage = 2;
          stageBadge.textContent = "CHAPTER 0: PRISM ALIGNMENT";
          typeWriter(narrativeSteps[2], narrativeEl);
          skylightSlider.value = 0;
          skylightSlider.min = -45;
          skylightSlider.max = 45;
          sliderIconMin.textContent = "📐";
          sliderIconMax.textContent = "🎯";
          state.prismAngle = 0;
          controlLabel.textContent = "ROTATE PRISM LENS ANGLE";
          const activeChar = state.mode === 'day' ? 'Solis' : 'Luna';
          const line = state.mode === 'day' ? state.dialogues.solis[2] : state.dialogues.luna[2];
          showDialogue(activeChar, line);
        }
      } else if (state.stage >= 2) {
        state.prismAngle = val;
      }
    });

    /* Day / Night Mode Switching with character transitions */
    btnDay.addEventListener('click', () => {
      AudioEngine.playClick();
      state.mode = 'day';
      btnDay.classList.add('active');
      btnNight.classList.remove('active');
      const text = state.dialogues.solis[state.dialogueIndex.solis];
      showDialogue("Solis", text);
    });

    btnNight.addEventListener('click', () => {
      AudioEngine.playClick();
      state.mode = 'night';
      btnNight.classList.add('active');
      btnDay.classList.remove('active');
      const text = state.dialogues.luna[state.dialogueIndex.luna];
      showDialogue("Luna", text);
    });

    /* Weather controls */
    weatherClearBtn.addEventListener('click', () => {
      AudioEngine.playClick();
      state.weather = 'clear';
      weatherClearBtn.classList.add('active');
      weatherRainBtn.classList.remove('active');
      weatherSnowBtn.classList.remove('active');
    });
    weatherRainBtn.addEventListener('click', () => {
      AudioEngine.playClick();
      state.weather = 'rain';
      weatherRainBtn.classList.add('active');
      weatherClearBtn.classList.remove('active');
      weatherSnowBtn.classList.remove('active');
    });
    weatherSnowBtn.addEventListener('click', () => {
      AudioEngine.playClick();
      state.weather = 'snow';
      weatherSnowBtn.classList.add('active');
      weatherClearBtn.classList.remove('active');
      weatherRainBtn.classList.remove('active');
    });

    /* Canvas Click Listener for Characters & Interactive Dialogue */
    canvas.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const clickY = e.clientY - rect.top;

      const activePos = state.mode === 'day' ? state.solisPos : state.lunaPos;
      const dist = Math.hypot(clickX - activePos.x, clickY - activePos.y);

      if (dist < 45) {
        AudioEngine.playChime();
        if (state.mode === 'day') {
          state.dialogueIndex.solis = (state.dialogueIndex.solis + 1) % state.dialogues.solis.length;
          showDialogue("Solis", state.dialogues.solis[state.dialogueIndex.solis]);
        } else {
          state.dialogueIndex.luna = (state.dialogueIndex.luna + 1) % state.dialogues.luna.length;
          showDialogue("Luna", state.dialogues.luna[state.dialogueIndex.luna]);
        }
      }
    });

    /* Draw Solis (Sunny Cozy Boy) in hand-drawn chibi style */
    function drawSolis(x, y, alpha) {
      ctx.save();
      ctx.globalAlpha = alpha;
      const floatY = y + Math.sin(state.animTime * 3) * 4;

      // Glow Aura
      const aura = ctx.createRadialGradient(x, floatY, 5, x, floatY, 38);
      aura.addColorStop(0, 'rgba(251, 191, 36, 0.45)');
      aura.addColorStop(1, 'rgba(251, 191, 36, 0)');
      ctx.fillStyle = aura;
      ctx.beginPath();
      ctx.arc(x, floatY, 38, 0, Math.PI * 2);
      ctx.fill();

      // Cape / Hoodie (Orange Warmth)
      ctx.fillStyle = '#f97316';
      ctx.beginPath();
      ctx.moveTo(x - 14, floatY + 12);
      ctx.quadraticCurveTo(x, floatY + 2, x + 14, floatY + 12);
      ctx.lineTo(x + 18, floatY + 30);
      ctx.lineTo(x - 18, floatY + 30);
      ctx.closePath();
      ctx.fill();

      // Body / Sweater
      ctx.fillStyle = '#fbbf24';
      ctx.beginPath();
      ctx.roundRect(x - 11, floatY + 6, 22, 22, 8);
      ctx.fill();

      // Head
      ctx.fillStyle = '#fde68a';
      ctx.beginPath();
      ctx.arc(x, floatY - 10, 15, 0, Math.PI * 2);
      ctx.fill();

      // Cozy Hair
      ctx.fillStyle = '#d97706';
      ctx.beginPath();
      ctx.arc(x, floatY - 14, 15, Math.PI, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.arc(x - 8, floatY - 12, 6, 0, Math.PI * 2);
      ctx.arc(x + 8, floatY - 12, 6, 0, Math.PI * 2);
      ctx.fill();

      // Face (Eyes & Blush)
      ctx.fillStyle = '#78350f';
      ctx.beginPath();
      ctx.arc(x - 5, floatY - 9, 2, 0, Math.PI * 2);
      ctx.arc(x + 5, floatY - 9, 2, 0, Math.PI * 2);
      ctx.fill();

      // Cheeks Blush
      ctx.fillStyle = 'rgba(244, 63, 94, 0.5)';
      ctx.beginPath();
      ctx.arc(x - 8, floatY - 6, 3, 0, Math.PI * 2);
      ctx.arc(x + 8, floatY - 6, 3, 0, Math.PI * 2);
      ctx.fill();

      // Sun Badge Accent
      ctx.fillStyle = '#f59e0b';
      ctx.beginPath();
      ctx.arc(x, floatY + 15, 4, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    /* Draw Luna (Calm Star Girl) in hand-drawn chibi style */
    function drawLuna(x, y, alpha) {
      ctx.save();
      ctx.globalAlpha = alpha;
      const floatY = y + Math.cos(state.animTime * 2.8) * 4;

      // Glow Aura
      const aura = ctx.createRadialGradient(x, floatY, 5, x, floatY, 38);
      aura.addColorStop(0, 'rgba(168, 85, 247, 0.45)');
      aura.addColorStop(1, 'rgba(168, 85, 247, 0)');
      ctx.fillStyle = aura;
      ctx.beginPath();
      ctx.arc(x, floatY, 38, 0, Math.PI * 2);
      ctx.fill();

      // Star Cape (Violet Moonlight)
      ctx.fillStyle = '#6b21a8';
      ctx.beginPath();
      ctx.moveTo(x - 15, floatY + 10);
      ctx.quadraticCurveTo(x, floatY + 2, x + 15, floatY + 10);
      ctx.lineTo(x + 20, floatY + 32);
      ctx.lineTo(x - 20, floatY + 32);
      ctx.closePath();
      ctx.fill();

      // Sweater
      ctx.fillStyle = '#c084fc';
      ctx.beginPath();
      ctx.roundRect(x - 12, floatY + 6, 24, 22, 8);
      ctx.fill();

      // Head
      ctx.fillStyle = '#f3e8ff';
      ctx.beginPath();
      ctx.arc(x, floatY - 10, 14, 0, Math.PI * 2);
      ctx.fill();

      // Long Cozy Lavender Hair
      ctx.fillStyle = '#a855f7';
      ctx.beginPath();
      ctx.arc(x, floatY - 13, 15, Math.PI, Math.PI * 2);
      ctx.fill();
      ctx.beginPath();
      ctx.ellipse(x - 12, floatY - 2, 6, 14, 0.2, 0, Math.PI * 2);
      ctx.ellipse(x + 12, floatY - 2, 6, 14, -0.2, 0, Math.PI * 2);
      ctx.fill();

      // Face (Eyes & Soft Smile)
      ctx.fillStyle = '#3b0764';
      ctx.beginPath();
      ctx.arc(x - 5, floatY - 9, 2, 0, Math.PI * 2);
      ctx.arc(x + 5, floatY - 9, 2, 0, Math.PI * 2);
      ctx.fill();

      // Cheeks Blush
      ctx.fillStyle = 'rgba(236, 72, 153, 0.4)';
      ctx.beginPath();
      ctx.arc(x - 7, floatY - 6, 2.5, 0, Math.PI * 2);
      ctx.arc(x + 7, floatY - 6, 2.5, 0, Math.PI * 2);
      ctx.fill();

      // Crescent Moon Hairpin
      ctx.fillStyle = '#fbbf24';
      ctx.beginPath();
      ctx.arc(x - 9, floatY - 16, 3.5, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }

    function render() {
      state.animTime += 0.03;
      ctx.clearRect(0, 0, width, height);

      // Room Background
      ctx.fillStyle = "#0a0e1a";
      ctx.fillRect(0, 0, width, height);

      // Skylight Dimensions
      const skylightWidth = width * 0.46;
      const skylightHeight = height * 0.22;
      const skylightX = (width - skylightWidth) / 2;
      const skylightY = height * 0.12;

      // Render Sky Window Interior
      ctx.save();
      ctx.beginPath();
      ctx.rect(skylightX, skylightY, skylightWidth, skylightHeight);
      ctx.clip();

      if (state.mode === 'day') {
        const skyGradient = ctx.createLinearGradient(0, skylightY, 0, skylightY + skylightHeight);
        skyGradient.addColorStop(0, state.weather === 'rain' ? '#475569' : '#38bdf8');
        skyGradient.addColorStop(1, state.weather === 'rain' ? '#94a3b8' : '#bae6fd');
        ctx.fillStyle = skyGradient;
        ctx.fillRect(skylightX, skylightY, skylightWidth, skylightHeight);

        if (state.weather === 'clear') {
          const sunX = skylightX + skylightWidth * 0.7;
          const sunY = skylightY + skylightHeight * 0.4;
          const sunGlow = ctx.createRadialGradient(sunX, sunY, 5, sunX, sunY, 65);
          sunGlow.addColorStop(0, '#ffffff');
          sunGlow.addColorStop(0.3, 'rgba(251, 191, 36, 0.85)');
          sunGlow.addColorStop(1, 'rgba(251, 191, 36, 0)');
          ctx.fillStyle = sunGlow;
          ctx.fillRect(skylightX, skylightY, skylightWidth, skylightHeight);
        }
      } else {
        const nightGrad = ctx.createLinearGradient(0, skylightY, 0, skylightY + skylightHeight);
        nightGrad.addColorStop(0, '#020617');
        nightGrad.addColorStop(1, '#1e1b4b');
        ctx.fillStyle = nightGrad;
        ctx.fillRect(skylightX, skylightY, skylightWidth, skylightHeight);

        state.stars.forEach(s => {
          s.alpha += s.speed;
          if (s.alpha > 1 || s.alpha < 0.2) s.speed = -s.speed;
          ctx.fillStyle = `rgba(255, 255, 255, ${Math.abs(s.alpha)})`;
          ctx.beginPath();
          ctx.arc(skylightX + s.x * skylightWidth, skylightY + s.y * skylightHeight, s.size, 0, Math.PI * 2);
          ctx.fill();
        });
      }

      // Weather Particles Inside Skylight
      if (state.weather === 'rain' || state.weather === 'snow') {
        ctx.fillStyle = state.weather === 'rain' ? 'rgba(186, 230, 253, 0.75)' : 'rgba(255, 255, 255, 0.85)';
        state.weatherParticles.forEach(wp => {
          wp.y += wp.speed;
          if (wp.y > skylightHeight) wp.y = 0;
          const wx = skylightX + (wp.x * skylightWidth);
          const wy = skylightY + wp.y;
          if (state.weather === 'rain') {
            ctx.fillRect(wx, wy, 1.5, 9);
          } else {
            ctx.beginPath();
            ctx.arc(wx, wy, wp.size, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      }
      ctx.restore();

      // Skylight Sliding Panels
      const openOffset = (state.aperture / 100) * (skylightWidth / 2);
      ctx.fillStyle = "#1e293b";
      ctx.strokeStyle = "#334155";
      ctx.lineWidth = 2.5;
      
      // Left Panel
      ctx.fillRect(skylightX, skylightY, (skylightWidth / 2) - openOffset, skylightHeight);
      ctx.strokeRect(skylightX, skylightY, (skylightWidth / 2) - openOffset, skylightHeight);
      // Right Panel
      ctx.fillRect(skylightX + (skylightWidth / 2) + openOffset, skylightY, (skylightWidth / 2) - openOffset, skylightHeight);
      ctx.strokeRect(skylightX + (skylightWidth / 2) + openOffset, skylightY, (skylightWidth / 2) - openOffset, skylightHeight);

      // Frame Outline
      ctx.strokeStyle = state.stage >= 3 ? '#a855f7' : '#38bdf8';
      ctx.lineWidth = 3.5;
      ctx.strokeRect(skylightX, skylightY, skylightWidth, skylightHeight);

      // Light Beam and Prism Logic
      if (state.aperture > 0) {
        const openingRatio = state.aperture / 100;
        const beamTopWidth = skylightWidth * openingRatio;
        const beamTopX = skylightX + (skylightWidth - beamTopWidth) / 2;
        
        const angleRad = (state.prismAngle * Math.PI) / 180;
        const beamBottomOffset = Math.sin(angleRad) * width * 0.42;
        const beamBottomX1 = beamTopX - 90 + beamBottomOffset;
        const beamBottomX2 = beamTopX + beamTopWidth + 90 + beamBottomOffset;
        const beamBottomY = height;

        ctx.save();
        const beamGradient = ctx.createLinearGradient(0, skylightY, 0, height);
        if (state.mode === 'day') {
          beamGradient.addColorStop(0, `rgba(255, 255, 255, ${0.45 * openingRatio})`);
          beamGradient.addColorStop(0.5, `rgba(56, 189, 248, ${0.25 * openingRatio})`);
          beamGradient.addColorStop(1, `rgba(251, 191, 36, 0)`);
        } else {
          beamGradient.addColorStop(0, `rgba(168, 85, 247, ${0.4 * openingRatio})`);
          beamGradient.addColorStop(1, `rgba(30, 27, 75, 0)`);
        }
        ctx.beginPath();
        ctx.moveTo(beamTopX, skylightY + skylightHeight);
        ctx.lineTo(beamTopX + beamTopWidth, skylightY + skylightHeight);
        ctx.lineTo(beamBottomX2, beamBottomY);
        ctx.lineTo(beamBottomX1, beamBottomY);
        ctx.closePath();
        ctx.fillStyle = beamGradient;
        ctx.fill();
        ctx.restore();

        // Target Core Position
        state.targetCore.x = width * 0.35;
        state.targetCore.y = height * 0.68;

        const beamCenterX = (beamBottomX1 + beamBottomX2) / 2;
        const distToCore = Math.abs(beamCenterX - state.targetCore.x);
        
        // Alignment Calculation & Resonance Meter
        if (state.stage >= 2) {
          if (distToCore < 40) {
            state.resonance = Math.min(100, state.resonance + 0.8);
          } else {
            state.resonance = Math.max(0, state.resonance - 0.3);
          }

          resonanceFill.style.width = `${state.resonance}%`;
          resonanceVal.textContent = `${Math.floor(state.resonance)}%`;

          // Automatic Narrative Transition to Chapter 1
          if (state.resonance >= 100 && state.stage === 2) {
            state.stage = 3;
            stageBadge.textContent = "CHAPTER 1: THE FIRST RESONANCE";
            stageBadge.classList.add('chapter-1');
            typeWriter(narrativeSteps[3], narrativeEl);
            AudioEngine.playChapterFanfare();

            const winSpeaker = state.mode === 'day' ? 'Solis' : 'Luna';
            const winText = state.mode === 'day' ? state.dialogues.solis[3] : state.dialogues.luna[3];
            showDialogue(winSpeaker, winText);
          }
        }

        // Draw Energy Core Shrine
        ctx.save();
        ctx.beginPath();
        ctx.arc(state.targetCore.x, state.targetCore.y, 24, 0, Math.PI * 2);
        const isCharged = state.resonance >= 100;
        ctx.fillStyle = isCharged ? '#a855f7' : (distToCore < 40 ? 'rgba(56, 189, 248, 0.6)' : 'rgba(251, 191, 36, 0.3)');
        ctx.shadowColor = isCharged ? '#a855f7' : '#fbbf24';
        ctx.shadowBlur = distToCore < 40 ? 30 : 12;
        ctx.fill();
        ctx.strokeStyle = isCharged ? '#f3e8ff' : '#fbbf24';
        ctx.lineWidth = 3.5;
        ctx.stroke();

        // Inner Shrine Core Rings
        ctx.beginPath();
        ctx.arc(state.targetCore.x, state.targetCore.y, 10 + Math.sin(state.animTime * 4) * 2, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();
        ctx.restore();

        // Floating Ambient Dust Particles inside room
        ctx.fillStyle = state.mode === 'day' ? 'rgba(255, 255, 255, 0.85)' : 'rgba(216, 180, 254, 0.85)';
        state.dustParticles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < 0) p.x = 1;
          if (p.x > 1) p.x = 0;
          if (p.y < 0) p.y = 1;
          if (p.y > 1) p.y = 0;
          const px = p.x * width;
          const py = p.y * height;
          if (py > skylightY + skylightHeight) {
            ctx.beginPath();
            ctx.arc(px, py, p.size, 0, Math.PI * 2);
            ctx.fill();
          }
        });
      }

      // Smooth Character Positions and Fade Transitions
      const solisTargetAlpha = state.mode === 'day' ? 1 : 0.25;
      const lunaTargetAlpha = state.mode === 'night' ? 1 : 0.25;

      state.solisPos.alpha += (solisTargetAlpha - state.solisPos.alpha) * 0.1;
      state.lunaPos.alpha += (lunaTargetAlpha - state.lunaPos.alpha) * 0.1;

      state.solisPos.x = width * 0.72;
      state.solisPos.y = height * 0.64;

      state.lunaPos.x = width * 0.82;
      state.lunaPos.y = height * 0.64;

      // Render Chibi Characters
      drawSolis(state.solisPos.x, state.solisPos.y, state.solisPos.alpha);
      drawLuna(state.lunaPos.x, state.lunaPos.y, state.lunaPos.alpha);

      // Positioning Dialogue Bubble above Active Character
      const activeCharPos = state.mode === 'day' ? state.solisPos : state.lunaPos;
      dialogueBubble.style.left = `${activeCharPos.x}px`;
      dialogueBubble.style.top = `${activeCharPos.y - 35}px`;

      requestAnimationFrame(render);
    }

    render();
  </script>
</body>
